<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <CelestePrefix Condition="'$(CelestePrefix)' == '' And Exists('../../../Celeste.dll')">../../..</CelestePrefix>
        <!-- Path to the CelesteTAS-EverestInterop.dll used for compile-time interop. -->
        <CelesteTasPath Condition="'$(CelesteTasPath)' == ''">$(CelestePrefix)\Mods\CelesteTAS-EverestInterop\bin\CelesteTAS-EverestInterop.dll</CelesteTasPath>
        <!-- Directory the built mod structure (DLL + everest.yaml + Dialog/Graphics) is copied to. -->
        <ModRoot Condition="'$(ModRoot)' == ''">..</ModRoot>
        <!-- Optional: when set, the built mod is deployed to this directory (e.g. Celeste\Mods\SpeedrunTool). -->
        <DeployDir Condition="'$(DeployDir)' == ''"></DeployDir>
        <!-- Opt-in profiling build: -p:SrtProfiling=true defines SRT_PROFILE and compiles
             SaveLoadProfiler in. The normal Release build contains no profiling code at all. -->
        <SrtProfiling Condition="'$(SrtProfiling)' == ''">false</SrtProfiling>
    </PropertyGroup>

    <Target Name="ValidateCelestePrefix" BeforeTargets="PrepareForBuild" Condition="'$(CelestePrefix)' == ''">
        <Error Text="Celeste.dll not found. Pass the Celeste install directory with -p:CelestePrefix=&quot;C:\Path\To\Celeste&quot;." />
    </Target>

    <PropertyGroup Condition="'$(SrtProfiling)' == 'true'">
        <DefineConstants>$(DefineConstants);SRT_PROFILE</DefineConstants>
    </PropertyGroup>
    
    <PropertyGroup>
        <ProjectGuid>{C7DFDD37-907C-4A75-96DA-1C5828C97F96}</ProjectGuid>
        <RootNamespace>Celeste.Mod.SpeedrunTool</RootNamespace>
        <AssemblyTitle>SpeedrunTool</AssemblyTitle>
        <Product>SpeedrunTool</Product>
        <Copyright>Copyright 漏 2019</Copyright>
        <PlatformTarget>x86</PlatformTarget>
        <OutputPath>bin\$(Configuration)\</OutputPath>
        <DebugType>portable</DebugType>
        <!-- MSB3277: MonoMod/MMHOOK reference the same assembly with different versions, expected here. -->
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3270;MSB3277</MSBuildWarningsAsMessages>
        <!-- CS0436: Publicizer generates IgnoresAccessChecksToAttribute, MonoMod.Utils has a copy.
             CS0649: ModInterop import fields are assigned by the ModInterop generator at runtime. -->
        <NoWarn>$(NoWarn);CS0436;CS0649</NoWarn>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    
    <ItemDefinitionGroup>
        <PackageReference IncludeAssets="compile" />
        <Reference>
            <Private>False</Private>
        </Reference>
    </ItemDefinitionGroup>
    <PropertyGroup>
        <PathMap>$(MSBuildProjectDirectory)=SpeedrunTool/</PathMap>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <Prefer32bit>false</Prefer32bit>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <Prefer32bit>false</Prefer32bit>
    </PropertyGroup>
    
    <!-- Dependency -->
    <ItemGroup>
        <PackageReference Include="JetBrains.Profiler.Api" Version="1.4.10">
            <IncludeAssets Condition="'$(Configuration)' == 'Debug'">all</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="KeraLua" Version="1.3.2" />
        <PackageReference Include="NLua" Version="1.4.25" />
        <PackageReference Include="YamlDotNet" Version="8.1.2" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="$(CelestePrefix)\Celeste.dll" />
        <Reference Include="$(CelestePrefix)\FNA.dll" />
        <Reference Include="$(CelestePrefix)\MMHOOK_Celeste.dll" />
        <Reference Include="$(CelestePrefix)\Mono.Cecil.dll" />
        <Reference Include="$(CelestePrefix)\MonoMod.Utils.dll" />
        <Reference Include="$(CelestePrefix)\MonoMod.RuntimeDetour.dll" />
        <Reference Include="CelesteTAS-EverestInterop">
            <HintPath>$(CelesteTasPath)</HintPath>
        </Reference>
    </ItemGroup>

    <!-- Publicizer -->
    <PropertyGroup>
        <PublicizerRuntimeStrategies>Unsafe;IgnoresAccessChecksTo</PublicizerRuntimeStrategies>
    </PropertyGroup>
    <ItemGroup>
        <Publicize Include="Celeste" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="MonoMod.Utils" />
        <Publicize Include="MonoMod.RuntimeDetour" />
    </ItemGroup>

    <!-- DeepCloner is vendored under SpeedrunTool\DeepCloner\ (see DeepCloner\UPSTREAM.md) and is picked up by the default glob. -->

    <!-- OutputAsModStructure -->
    <ItemGroup>
        <DialogResources Include="$(MSBuildProjectDirectory)\Dialog\**\*" />
        <GraphicResources Include="$(MSBuildProjectDirectory)\Graphics\**\*" />
    </ItemGroup>

    <Target Name="OutputAsModStructure" AfterTargets="Build">
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ModRoot)" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(ModRoot)" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)\everest.yaml" DestinationFolder="$(ModRoot)" />
        <Copy SourceFiles="@(DialogResources)" DestinationFolder="$(ModRoot)\Dialog\%(RecursiveDir)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(GraphicResources)" DestinationFolder="$(ModRoot)\Graphics\%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>

    <!-- Optional convenience target: deploys the built mod into a Celeste Mods directory in one command, e.g.
         dotnet build -c Release -p:CelestePrefix="C:\Celeste" -p:DeployDir="C:\Celeste\Mods\SpeedrunTool" -->
    <!-- Release packaging: dotnet build -c Release -p:CelestePrefix=... -t:PackageMod -p:PackageMod=true -p:SrtPackageVersion=3.29.1
         Produces dist/SpeedrunTool-<PackageVersion>.zip with the same layout as the manual
         toZip.cmd used to make: everest.yaml + SpeedrunTool.dll at the zip root plus Dialog/
         and Graphics/. Not run automatically on every build: packaging a release is an explicit
         step and the version in everest.yaml stays the single source of truth; pass
         -p:SrtPackageVersion=... to put a version into the release asset name. -->
    <Target Name="PackageMod" AfterTargets="Build" DependsOnTargets="OutputAsModStructure"
            Condition="'$(PackageMod)' == 'true'">
        <PropertyGroup>
            <_PackageStage>$(BaseIntermediateOutputPath)package</_PackageStage>
            <_PackageSuffix Condition="'$(SrtPackageVersion)' != ''">-$(SrtPackageVersion)</_PackageSuffix>
            <_PackageZip>$(MSBuildProjectDirectory)\..\dist\SpeedrunTool$(_PackageSuffix).zip</_PackageZip>
        </PropertyGroup>
        <RemoveDir Directories="$(_PackageStage)" />
        <MakeDir Directories="$(_PackageStage);$(MSBuildProjectDirectory)\..\dist" />
        <Copy SourceFiles="$(ModRoot)\$(AssemblyName).dll;$(MSBuildProjectDirectory)\everest.yaml" DestinationFolder="$(_PackageStage)" />
        <ItemGroup>
            <_PackageDialog Include="$(MSBuildProjectDirectory)\Dialog\**\*" />
            <_PackageGraphics Include="$(MSBuildProjectDirectory)\Graphics\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_PackageDialog)" DestinationFiles="@(_PackageDialog->'$(_PackageStage)\Dialog\%(RecursiveDir)%(Filename)%(Extension)')" />
        <Copy SourceFiles="@(_PackageGraphics)" DestinationFiles="@(_PackageGraphics->'$(_PackageStage)\Graphics\%(RecursiveDir)%(Filename)%(Extension)')" />
        <ZipDirectory SourceDirectory="$(_PackageStage)" DestinationFile="$(_PackageZip)" Overwrite="true" />
        <Message Importance="high" Text="Packaged $(AssemblyName) -> $(_PackageZip)" />
    </Target>

    <Target Name="DeployToGame" AfterTargets="OutputAsModStructure" Condition="'$(DeployDir)' != ''">
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(DeployDir)" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)\everest.yaml" DestinationFolder="$(DeployDir)" />
        <Copy SourceFiles="@(DialogResources)" DestinationFolder="$(DeployDir)\Dialog\%(RecursiveDir)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(GraphicResources)" DestinationFolder="$(DeployDir)\Graphics\%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>
</Project>
